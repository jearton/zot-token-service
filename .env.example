# Required: public registry identity and token endpoint.
REGISTRY_SERVICE=
REGISTRY_REALM=

# Required: Base64-encoded, 32-byte AES key. Generate with:
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Required: reachable Zot Registry API URL.
ZOT_URL=

# Optional runtime tuning.
TOKEN_TTL=15m
ZOT_AUTH_TIMEOUT=10s
ZOT_HEALTH_TIMEOUT=3s
LISTEN_ADDR=:8080
