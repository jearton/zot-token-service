# Required: Base64-encoded, 32-byte AES key. Generate with:
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Public registry identity.
REGISTRY_SERVICE=registry.example.com
REGISTRY_REALM=https://registry.example.com/token
REGISTRY_TOKEN_ISSUER=zot-token-service
TOKEN_TTL=15m

# Reachable Zot Registry API URL.
ZOT_URL=http://zot:5000
ZOT_AUTH_TIMEOUT=10s
ZOT_HEALTH_TIMEOUT=3s
LISTEN_ADDR=:8080
